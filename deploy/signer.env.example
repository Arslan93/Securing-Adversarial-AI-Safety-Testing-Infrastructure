BAYORA_SIGNER_SOCKET=/run/bayora-signer/signer.sock
BAYORA_SIGNER_SOCKET_MODE=0660
BAYORA_SIGNER_DB=/var/lib/bayora-signer/ledger.db
BAYORA_SIGNER_PRIVATE_KEY=/var/lib/bayora-signer/private.pem
# Same credential value as the API copy; separately owned, 0600 files.
BAYORA_SIGNER_TOKEN=/var/lib/bayora-signer/client-token
