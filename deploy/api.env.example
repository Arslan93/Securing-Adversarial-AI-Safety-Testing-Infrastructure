# Template only. No real service or identity provider is configured by this file.
NODE_ENV=production
BAYORA_PILOT_MODE=true
BAYORA_DEMO_AUTH=false
BAYORA_HOST=127.0.0.1
PORT=3001
BAYORA_PUBLIC_ORIGIN=https://REPLACE_WITH_PILOT_DOMAIN
BAYORA_TRUST_PROXY=true
BAYORA_DB=/var/lib/bayora/bayora.db
BAYORA_AUTH_KEY=/var/lib/bayora/auth-master.key
BAYORA_OIDC_ISSUER=https://REPLACE_WITH_ISSUER
BAYORA_OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
BAYORA_OIDC_CLIENT_SECRET_FILE=/etc/bayora/api-secrets/oidc-secret
BAYORA_OIDC_REQUIRE_MFA=true
BAYORA_REQUIRE_SIGNED_EVIDENCE=true
BAYORA_SIGNER_SOCKET=/run/bayora-signer/signer.sock
BAYORA_SIGNER_TOKEN=/etc/bayora/api-secrets/signer-client-token
BAYORA_EVIDENCE_PUBLIC_KEY=/etc/bayora/public.pem
BAYORA_PILOT_ACCEPTANCE_FILE=/etc/bayora/pilot-acceptance.json
BAYORA_CONTAINER_RUNTIME=true
BAYORA_WORKER_IMAGE=sha256:REPLACE_WITH_VALIDATED_IMAGE_ID
BAYORA_MODEL_IMAGE=sha256:REPLACE_WITH_VALIDATED_IMAGE_ID
BAYORA_MODEL_VOLUME=REPLACE_WITH_APPROVED_LOCAL_VOLUME
BAYORA_CONTAINER_MODEL=REPLACE_WITH_APPROVED_MODEL
BAYORA_CONTAINER_MODEL_DIGEST=REPLACE_WITH_FULL_DIGEST
BAYORA_MODEL_MEMORY_MB=4096
BAYORA_WORKER_CONCURRENCY=1
BAYORA_MAX_ACTIVE_RUNS=1
BAYORA_WORKER_LEASE_MS=5000
# Use a reviewed local Docker endpoint. API access to a daemon is privileged.
DOCKER_HOST=unix:///run/REPLACE_WITH_REVIEWED_DOCKER_ENDPOINT.sock
