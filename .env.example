# Copy to .env for local development. Never commit credentials to this file.
NODE_ENV=development
BAYORA_HOST=127.0.0.1
PORT=3001
BAYORA_FRONTEND_PORT=5173
BAYORA_DB=.data/bayora.db
# Legacy name: enables local credential accounts, not a role picker.
BAYORA_DEMO_AUTH=true
BAYORA_SESSION_MINUTES=60
BAYORA_MAX_ACTIVE_RUNS=2
BAYORA_OLLAMA_ORIGIN=http://127.0.0.1:11434

# Phase 4: opt-in local Docker profile. See docs/PHASE4.md before enabling.
BAYORA_CONTAINER_RUNTIME=false
# Immutable local image IDs, not tags; populate after building approved images.
BAYORA_WORKER_IMAGE=
BAYORA_MODEL_IMAGE=
# Existing named volume labeled bayora.models.approved=true; never a host path.
BAYORA_MODEL_VOLUME=
BAYORA_CONTAINER_MODEL=
BAYORA_CONTAINER_MODEL_DIGEST=
# Per model container. A run creates two model containers plus Red/Blue workers.
BAYORA_MODEL_MEMORY_MB=4096

# Phase 5. Generate with npm run evidence:init; API reads only the public key/client token.
BAYORA_SIGNER_SOCKET=
BAYORA_SIGNER_TOKEN=.data/signing/client-token
BAYORA_EVIDENCE_PUBLIC_KEY=
BAYORA_REQUIRE_SIGNED_EVIDENCE=false
# Signer process only; keep private key outside the API account in a protected deployment.
BAYORA_SIGNER_PRIVATE_KEY=.data/signing/private.pem
BAYORA_SIGNER_DB=.data/signing/ledger.db
# Optional external IdP. HTTP is permitted only for explicit loopback development testing.
BAYORA_PUBLIC_ORIGIN=
BAYORA_OIDC_ISSUER=
BAYORA_OIDC_CLIENT_ID=
BAYORA_OIDC_CLIENT_SECRET=
BAYORA_OIDC_ALLOW_HTTP=false
BAYORA_OIDC_REQUIRE_MFA=false
BAYORA_OIDC_ACR_VALUES=

# Durable execution: one API broker per database; separate subprocess workers.
BAYORA_WORKER_CONCURRENCY=1
BAYORA_WORKER_LEASE_MS=5000

# Restricted pilot is opt-in; leave false for the local hackathon app.
BAYORA_PILOT_MODE=false
BAYORA_TRUST_PROXY=false
# File must be a private regular 0400/0600 file. Do not set the inline secret too.
# BAYORA_OIDC_CLIENT_SECRET_FILE=/etc/bayora/api-secrets/oidc-secret
# Operator-recorded, reviewed gates; template is deliberately unapproved.
# BAYORA_PILOT_ACCEPTANCE_FILE=/etc/bayora/pilot-acceptance.json
