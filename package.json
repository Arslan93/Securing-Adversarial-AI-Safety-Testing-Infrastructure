{
  "name": "bayora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs src/lib/*.test.js",
    "format": "prettier --write src server scripts runtime/*.mjs docs/*.md vite.config.js package.json README.md deploy/pilot-acceptance.example.json .github/workflows/*.yml",
    "format:check": "prettier --check src server scripts runtime/*.mjs docs/*.md vite.config.js package.json README.md deploy/pilot-acceptance.example.json .github/workflows/*.yml",
    "server": "node --watch server/index.mjs",
    "client": "vite",
    "runtime:check": "node scripts/runtime-check.mjs",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "evidence:init": "node scripts/evidence-init.mjs",
    "evidence:signer": "node scripts/evidence-signer.mjs",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "data:backup": "node scripts/data-backup.mjs",
    "runtime:acceptance": "node scripts/runtime-acceptance.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "data:restore": "node scripts/data-restore.mjs",
    "test:e2e": "node scripts/hackathon-qa.mjs",
    "runtime:worker-acceptance": "node scripts/runtime-worker-acceptance.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "pilot:load": "node scripts/pilot-load.mjs",
    "data:compact": "node scripts/data-compact.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
